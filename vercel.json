{
    "public": "public",
    "functions": {
        "api/app.py": {
            "runtime": "python3.9"
        }
    },
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/app.py"
        },
        {
            "src": "/(.*)",
            "dest": "/public/index.html"
        }
    ]
}