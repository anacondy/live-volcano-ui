{
    "buildCommand": "echo 'No build step needed'",
    "outputDirectory": ".",
    "public": ".",
    "functions": {
        "api/app.py": {
            "runtime": "python3.9"
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/app.py"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/index.html",
            "status": 200
        }
    ]
}